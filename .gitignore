# Root .gitignore for Synaptech ERP

# Node / Angular (frontend)
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/tmp/
frontend/out-tsc/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# .NET / C# (backend)
backend/**/bin/
backend/**/obj/
backend/**/.vs/
backend/**/*.user
backend/**/*.userosscache
backend/**/*.suo

# Environment & Local overrides
*.env.local
*.user.config
appsettings.Development.local.json

# IDEs & System
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
